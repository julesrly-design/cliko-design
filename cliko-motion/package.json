{
  "name": "cliko-motion",
  "version": "1.0.0",
  "description": "Cliko : reel motion design 3D (Remotion + React Three Fiber), 1080×1920 60 fps",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc --noEmit",
    "stills": "node scripts/stills.mjs",
    "sfx": "NODE_USE_ENV_PROXY=1 node scripts/sfx.mjs",
    "sfx:synth": "python3 scripts/synth_sfx.py",
    "sfx:list": "tsx scripts/sfx-list.ts",
    "render": "remotion render src/index.ts ClikoMotion out/cliko-motion.mp4",
    "thumbnail": "tsx scripts/thumbnail.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/three": "4.0.534",
    "opentype.js": "1.3.4",
    "postprocessing": "6.37.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/opentype.js": "1.3.8",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
