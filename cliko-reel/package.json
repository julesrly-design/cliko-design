{
  "name": "cliko-reel",
  "version": "1.0.0",
  "description": "Reel de présentation Cliko (motion design, Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/light-leaks": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "^4.0.534",
    "@types/three": "0.180.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "playwright": "1.56",
    "prettier": "3.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "brand": "node scripts/brand.mjs",
    "capture": "node scripts/capture.mjs",
    "casting:list": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/voice-casting.mjs list",
    "casting:gen": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/voice-casting.mjs gen",
    "voice": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/voice.mjs",
    "sfx": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/sfx.mjs",
    "music": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/music.mjs",
    "audio": "tsx scripts/export-timeline.ts && python3 scripts/synth_audio.py public/timeline-A.json && python3 scripts/synth_audio.py public/timeline-B.json",
    "capture-demos": "node scripts/capture-demos.mjs",
    "fx": "python3 scripts/make_fx.py"
  }
}
